# Host HTTP port exposed by Nginx on the VPS (default: 80)
HTTP_PORT=80

# Set to false to allow multiple votes from the same IP (e.g. shared office/event Wi-Fi)
ENFORCE_IP_DEDUP=true

# Secret key for HMAC-hashing client IPs. Leave empty to auto-generate one and
# persist it as `ip_hash_secret` next to the database (inside the data volume).
IP_HASH_SECRET=

# Delete polls with no activity (creation or votes) for this many days (default: 365)
RETENTION_DAYS=365
